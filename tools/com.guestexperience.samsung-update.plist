<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: tools/install-samsung-autoupdate.sh fills in __SCRIPT__ and __HOME__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.guestexperience.samsung-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
        <string>--once</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/GuestExperience/samsung-update.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/GuestExperience/samsung-update.launchd.log</string>
</dict>
</plist>

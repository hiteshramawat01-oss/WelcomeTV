<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app hand a verified update to Android's installer (the user still confirms it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Downloads update.json and the APK from github.com over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <receiver
            android:name="com.guestexperience.updater.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
